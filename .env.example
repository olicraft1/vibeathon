# CharlaViva configuration — copy to .env and edit.

# --- Core server ---
HOST=0.0.0.0
PORT=8000

# --- Engine selection ---
# auto      : gemini if GEMINI_API_KEY is set, else local whisper, else canned demo
# gemini    : Gemini Live API (recommended: best quality + real EN<->ES translation)
# whisper   : 100% local transcription with faster-whisper (+ Gemini text translation if key set)
# canned    : replay of pre-computed transcripts for the bundled samples (no models at all)
CHARLAVIVA_ENGINE=auto

# --- Gemini Live (optional) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# General live model (captioning + translation in one connection)
GEMINI_MODEL=gemini-3.8-live
# Specialized low-latency transcription model (used when GEMINI_MODE=transcribe)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# caption    : the live model emits [lang]-tagged caption lines + input transcription
# transcribe : specialized ASR model + text translation of each finished utterance
GEMINI_MODE=caption
# Text model used to translate finished utterances (whisper engine / transcribe mode)
TRANSLATE_MODEL=gemini-flash-latest

# --- Local whisper (optional) ---
# tiny | base | small | medium | large-v3  (small is a good quality/latency tradeoff)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# --- Captioning behaviour ---
# Languages the audience can request: original is always available.
# Supported codes: es, en, pt (add more by extending the gloss prompt).
DEFAULT_OUTPUTS=es,en
# Silence (ms) that ends an utterance for our client-side VAD (hybrid VAD)
VAD_SILENCE_MS=600
